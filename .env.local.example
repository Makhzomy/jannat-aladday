# Copy to .env.local and fill in for local development.
# On Vercel, BLOB_READ_WRITE_TOKEN is injected automatically once a Blob
# store is linked to the project — you only need to set the two admin
# values below in the project's Environment Variables settings.

# Auto-provisioned by Vercel Blob (or run `vercel env pull .env.local`)
BLOB_READ_WRITE_TOKEN=

# Password for /admin — pick something strong, not reused elsewhere
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
